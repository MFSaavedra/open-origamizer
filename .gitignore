# Build output
/build/
/build-*/
/dist/
/wheelhouse/
*.egg-info/
*.o
*.a
*.so
*.dylib
*.pyd
# Note: *.obj is NOT ignored; OBJ is the input mesh format.

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors and tooling
.vscode/
.idea/
.cache/
compile_commands.json

# LaTeX build files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Sample models of the original Origamizer, copied here locally (see the
# README in that folder and CLAUDE.md, Decisions). Not committed: they come
# with Origamizer under its non-commercial license, and bunny170 derives from
# the Stanford bunny, whose terms forbid commercial use without permission.
/examples/meshes/origamizer/*
!/examples/meshes/origamizer/README.md

# Guardrails (see CLAUDE.md, Hard constraints): never commit Tachi's binary or
# files it produced, and never commit IEEE or ASME paper PDFs. Built PDFs stay
# out too. Openly licensed papers are allowed one by one below.
*.exe
*.dll
*.pdf
!/docs/papers/Demaine-Tachi-2017-Origamizer-SoCG.pdf
# Compiled PDFs of our own LaTeX notes (committed next to their sources).
!/docs/tvcg2010-notes.pdf
!/docs/notes.pdf
